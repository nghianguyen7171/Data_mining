<section class="hero">
  <div class="wrap">
    <p class="hero-eyebrow">{{course.code}} · {{course.semester}}</p>
    <h1 class="hero-title">{{course.title}}</h1>
    <dl class="hero-facts">
      <div><dt>Credits</dt><dd>{{course.credits}}</dd></div>
      <div><dt>Lecture</dt><dd>{{course.hours.lecture}} h</dd></div>
      <div><dt>Lab</dt><dd>{{course.hours.lab}} h</dd></div>
      <div><dt>Self-study</dt><dd>{{course.hours.self_study}} h</dd></div>
      <div><dt>Type</dt><dd>{{course.type}}</dd></div>
    </dl>
  </div>
</section>
